{
  "name": "eia-app",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test && pnpm test:worker",
    "test:worker": "cd apps/worker && python -m pytest -q",
    "db:types": "supabase gen types typescript --project-id loqjuedwwjoagwdhilqh --schema public > apps/web/src/types/database.ts"
  }
}
